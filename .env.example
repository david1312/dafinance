# Local: either naming works. NEXT_PUBLIC_ is inlined into the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Vercel: store these as Secret (no public prefix). The build copies them
# into NEXT_PUBLIC_* so the browser client still works.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
